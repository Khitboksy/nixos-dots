{
  "Nix Module Template": {
    "prefix": "nixcfg",
    "body": [
      "{",
      "  lib,",
      "  config,",
      "  pkgs,",
      "  zenith,",
      "  # inputs,  only needed for flake related modules",
      "  ...",
      "}:",
      "",
      "with zenith.lib';",
      "",
      "let",
      "  cfg = config.${1:moduleName};",
      "in",
      "",
      "{",
      "  options.${1:moduleName} = with lib.types; {",
      "    enable = mkBoolOpt false \"${2:Description}\";",
      "  };",
      "",
      "  config = lib.mkIf cfg.enable {",
      "    $0",
      "  };",
      "}"
    ],
    "description": "Template for a Nix module"
  }
}
