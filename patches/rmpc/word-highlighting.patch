+            end: None,
+            content: content.to_string(),
+        }
+    }
+
+    fn line(words: Vec<LrcWord>) -> LrcLine {
+        let content = words.iter().map(|word| word.content.as_str()).collect();
+        LrcLine { time: Duration::from_millis(0), content, words }
+    }
+
+    fn styles() -> WordStyles {
+        WordStyles {
+            sung: Style::default(),
+            unsung: Style::default(),
+            active: Some(Style::default().add_modifier(Modifier::BOLD)),
+        }
+    }
+
+    #[test]
+    fn words_usable_requires_matching_content() {
+        let line = line(vec![word("Hello", 0), word(" world", 100)]);
+        assert!(words_usable(&line));
+
+        let broken = LrcLine {
+            time: Duration::from_millis(0),
+            content: "Goodbye world".to_string(),
+            words: vec![word("Hello", 0), word(" world", 100)],
+        };
+        assert!(!words_usable(&broken));
+
+        let empty =
+            LrcLine { time: Duration::from_millis(0), content: "x".to_string(), words: vec![] };
+        assert!(!words_usable(&empty));
+    }
+
+    #[test]
+    fn current_word_idx_tracks_elapsed() {
+        let line = line(vec![word("one", 1000), word(" two", 2000), word(" three", 3000)]);
+        let offset = LrcOffset::from_millis(0);
+
+        assert_eq!(current_word_idx(&line, Duration::from_millis(500), offset), None);
+        assert_eq!(current_word_idx(&line, Duration::from_millis(2000), offset), Some(1));
+        assert_eq!(current_word_idx(&line, Duration::from_millis(9999), offset), Some(2));
+    }
+
+    #[test]
+    fn word_line_spans_styles_and_wraps() {
+        let line = line(vec![word("hello", 0), word(" world", 1000)]);
+        let styles = styles();
+
+        let rows = word_line_spans(&line, 80, Some("[00:01] "), Some(0), &styles).unwrap();
+        assert_eq!(rows.len(), 1);
+        assert_eq!(rows[0].len(), 3);
+        assert_eq!(rows[0][0].content, "[00:01] ");
+        assert_eq!(rows[0][0].style, styles.unsung);
+        assert_eq!(rows[0][1].content, "hello");
+        assert_eq!(rows[0][1].style, styles.active.unwrap());
+        assert_eq!(rows[0][2].content, " world");
+        assert_eq!(rows[0][2].style, styles.unsung);
+
+        let wrapped = word_line_spans(&line, 5, None, Some(1), &styles).unwrap();
+        assert_eq!(wrapped.len(), 2);
+        assert_eq!(wrapped[0][0].content, "hello");
+        assert_eq!(wrapped[0][0].style, styles.sung);
+        assert_eq!(wrapped[1][0].content, "world");
+        assert_eq!(wrapped[1][0].style, styles.active.unwrap());
+    }
+
+    #[test]
+    fn active_defaults_to_sung_style() {
+        let line = line(vec![word("one", 0), word(" two", 100)]);
+        let sung = Style::default().add_modifier(Modifier::BOLD);
+        let styles = WordStyles { sung, unsung: Style::default(), active: None };
+
+        let rows = word_line_spans(&line, 80, None, Some(0), &styles).unwrap();
+        // Without a theme override the active word renders exactly like a
+        // sung word - no underline, no extra modifier.
+        assert_eq!(rows[0][0].content, "one");
+        assert_eq!(rows[0][0].style, sung);
+        assert!(!rows[0][0].style.add_modifier.contains(Modifier::UNDERLINED));
+        assert_eq!(rows[0][1].content, " two");
+        assert_eq!(rows[0][1].style, styles.unsung);
+    }
+}
