+/// Styles used when rendering a word-timed line.
+struct WordStyles {
+    /// Words that have already been sung take the highlighted style
+    sung: Style,
+    /// Words not yet reached, and the timestamp prefix, stay plain
+    unsung: Style,
+    /// Style override for the currently active word (defaults to `sung`)
+    active: Option<Style>,
+}
+
+/// Whether the line's words can be trusted to reconstruct its content.
+fn words_usable(line: &LrcLine) -> bool {
+    if line.words.is_empty() {
+        return false;
+    }
+    let reconstructed: String = line.words.iter().map(|word| word.content.as_str()).collect();
+    reconstructed == line.content
+}
+
+/// Index of the last word whose start time has been reached, if any.
+fn current_word_idx(line: &LrcLine, elapsed: Duration, offset: LrcOffset) -> Option<usize> {
+    line.words
+        .iter()
+        .enumerate()
+        .filter(|(_, word)| elapsed >= word.time(offset))
+        .map(|(idx, _)| idx)
+        .last()
+}
+
+/// Render the active line as styled rows, breaking on whitespace like
+/// `textwrap`. Returns None when the line has no usable word timings so
+/// the caller can fall back to plain line rendering.
+fn word_line_spans(
+    line: &LrcLine,
+    width: usize,
+    prefix: Option<&str>,
+    active_idx: Option<usize>,
+    styles: &WordStyles,
+) -> Option<Vec<Vec<Span<'static>>>> {
+    if width == 0 || !words_usable(line) {
+        return None;
+    }
+
+    // The active word joins the already-sung fill; a theme override wins.
+    let active_style = styles.active.unwrap_or(styles.sung);
+    let mut chars: Vec<(char, Style)> = Vec::new();
+    if let Some(prefix) = prefix {
+        chars.extend(prefix.chars().map(|ch| (ch, styles.unsung)));
+    }
+    for (idx, word) in line.words.iter().enumerate() {
+        let style = match active_idx {
+            Some(active) if idx == active => active_style,
+            Some(active) if idx < active => styles.sung,
+            _ => styles.unsung,
+        };
+        chars.extend(word.content.chars().map(|ch| (ch, style)));
+    }
+
+    let mut rows: Vec<Vec<(char, Style)>> = Vec::new();
+    let mut row: Vec<(char, Style)> = Vec::new();
+    let mut row_width = 0usize;
+    let mut last_whitespace: Option<usize> = None;
+
+    for (ch, style) in chars {
+        let ch_width = ch.width().unwrap_or(0);
+        if ch_width > 0 && row_width + ch_width > width && !row.is_empty() {
+            if let Some(break_at) = last_whitespace {
+                let tail = row.split_off(break_at + 1);
+                row.pop();
+                rows.push(std::mem::take(&mut row));
+                row = tail;
+                last_whitespace = row.iter().rposition(|(c, _)| c.is_whitespace());
+                row_width = row.iter().map(|(c, _)| c.width().unwrap_or(0)).sum();
+            } else {
+                rows.push(std::mem::take(&mut row));
+                last_whitespace = None;
+                row_width = 0;
+            }
+        }
+        if ch.is_whitespace() && row.is_empty() {
+            continue;
+        }
+        if ch.is_whitespace() {
+            last_whitespace = Some(row.len());
+        }
+        row.push((ch, style));
+        row_width += ch_width;
+    }
+    rows.push(row);
+
+    Some(
+        rows.into_iter()
+            .map(|row| {
+                let mut spans: Vec<Span<'static>> = Vec::new();
+                for (ch, style) in row {
+                    match spans.last_mut() {
+                        Some(last) if last.style == style => last.content.to_mut().push(ch),
+                        _ => spans.push(Span::styled(ch.to_string(), style)),
+                    }
+                }
+                spans
+            })
+            .collect(),
+    )
+}
