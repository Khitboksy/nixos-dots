     pub fn new() -> Self {
         Self { area: Rect::default() }
     }
+
+    fn seek_to_x(&self, x: u16, ctx: &Ctx) -> Result<()> {
+        let x = x.clamp(
+            self.area.x,
+            self.area.x.saturating_add(self.area.width.saturating_sub(1)),
+        );
+        let seconds_to_seek_to = ctx
+            .status
+            .duration
+            .mul_f32(f32::from(x.saturating_sub(self.area.x)) / f32::from(self.area.width.max(1)))
+            .as_secs_f32();
+        ctx.command(move |_, client| {
+            client.seek_current(ValueChange::Set(seconds_to_seek_to))?;
+            Ok(())
+        });
+
+        ctx.render()?;
+        Ok(())
+    }
 }
 
